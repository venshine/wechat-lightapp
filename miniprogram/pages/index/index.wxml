<view class="page">
  <view class="hero">
    <view class="hero-title">微信小程序现代示例</view>
    <view class="hero-sub">基础库 {{sdkVersion}} · 主题 {{theme}} · 渲染 {{renderer}}</view>
  </view>

  <view class="section-title">示例</view>
  <demo-card
    wx:for="{{entries}}"
    wx:key="path"
    title="{{item.title}}"
    desc="{{item.desc}}"
  >
    <view class="go" data-path="{{item.path}}" bind:tap="open">进入 ›</view>
  </demo-card>
</view>
